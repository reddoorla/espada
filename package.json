{
  "name": "espada",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:vite:dev\" \"npm:slicemachine\" --prefix-colors blue,magenta",
    "vite:dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . --plugin prettier-plugin-svelte . && eslint .",
    "format": "prettier --write . --plugin prettier-plugin-svelte .",
    "slicemachine": "start-slicemachine",
    "vite:devHost": "vite dev --host --port 8888"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@reddoorla/maintenance": "^0.40.0",
    "@slicemachine/adapter-sveltekit": "^0.3.96",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/enhanced-img": "^0.4.1",
    "@sveltejs/kit": "^2.5.27",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.19",
    "@zerodevx/svelte-img": "^2.1.2",
    "concurrently": "^8.2.2",
    "eslint": "^10.4.0",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^3.2.6",
    "sharp": "^0.33.5",
    "slice-machine-ui": "^2.21.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.0",
    "typescript-svelte-plugin": "^0.3.36",
    "vite": "^6.0.7",
    "vite-imagetools": "^7.0.4"
  },
  "type": "module",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "@fortawesome/free-regular-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/svelte-fontawesome": "^0.2.2",
    "@prismicio/client": "^7.3.1",
    "@prismicio/svelte": "^2.2.1",
    "svelte-gestures": "^4.0.0",
    "svelte-select": "^5.8.3"
  },
  "packageManager": "pnpm@11.7.0"
}
